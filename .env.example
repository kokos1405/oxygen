# Shopify app credentials. Filled by `shopify app dev` / Partner Dashboard.
# Never commit real values.
# Do not install or deploy to the live shop nth02c-ir.myshopify.com without merchant approval.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=http://localhost:3000
SCOPES=read_products,read_inventory,read_orders,read_customers,read_locations

# Oxygen Pelatologio — SANDBOX ONLY.
# The only API base is https://sandbox-api.oxygen.gr/v1.
# The client refuses the production host api.oxygen.gr.
# Leave OXYGEN_API_KEY empty to skip the health check and the admin connection call.
OXYGEN_API_KEY=
OXYGEN_API_BASE_URL=https://sandbox-api.oxygen.gr/v1

# One Oxygen warehouse id for every Shopify location.
# Empty: inventory_levels/update does not write stock. Product create throws
# instead of sending warehouses: []. Create sends warehouses: [{ id, quantity: 0 }].
OXYGEN_DEFAULT_WAREHOUSE_ID=

# Optional payment-method UUID overrides. Empty: resolve with GET /payment-methods (cached).
# cash/manual/cod → Μετρητά, card/shopify_payments/stripe → POS/e-POS, paypal → PayPal.
# bogus/unknown → OXYGEN_PAYMENT_METHOD_DEFAULT, else Μετρητά, else the first active method (logged).
OXYGEN_PAYMENT_METHOD_CASH=
OXYGEN_PAYMENT_METHOD_CARD=
OXYGEN_PAYMENT_METHOD_PAYPAL=
OXYGEN_PAYMENT_METHOD_DEFAULT=
